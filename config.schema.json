{
  "pluginAlias": "SshTtyPlugin",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "SSH TTY",
        "required": true
      },
      "ssh": {
        "title": "SSH",
        "type": "object",
        "properties": {
          "username": {
            "description": "SSH User",
            "type": "string",
            "default": "",
            "placeholder": "admin",
            "required": false
          },
          "rsa": {
            "description": "SSH RSA Path",
            "type": "string",
            "pattern": "^\\[a-zA-Z0-9_-/.]+$",
            "placeholder": "/path/to/.ssh/id_rsa",
            "required": false
          },
          "port": {
            "description": "SSH port",
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(:\\d+)?",
            "placeholder": "192.168.1.1",
            "default": "",
            "required": false
          }
        }
      },
      "actions": {
        "type": "array",
        "items": {
          "title": "Actions",
          "description": "Create buttons here",
          "type": "object",
          "properties": {
            "id": {
              "title": "Unique ID",
              "description": "A unique identifier for this button",
              "type": "string",
              "required": true,
              "pattern": "^\\S.*\\S$",
              "maxLength": 64
            },
            "name": {
              "title": "Name",
              "description": "Display name for the button",
              "type": "string",
              "required": true,
              "pattern": "^\\S.*\\S$",
              "maxLength": 64
            },
            "commands": {
              "type": "array",
              "title": "Commands",
              "description": "An array of commands. A radio button is created for each command",
              "required": true,
              "items": {
                "title": "Command",
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "required": true,
                    "pattern": "^\\S.*\\S$",
                    "maxLength": 64
                  },
                  "command": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9. /-_]+$",
                    "required": true
                  }
                }
              }
            },
            "sudo": {
              "title": "Sudo",
              "description": "Use sudo to run commands",
              "type": "boolean",
              "default": false,
              "required": false
            },
            "isSsh": {
              "title": "Is SSH",
              "description": "is this command sent via SSH?",
              "type": "boolean",
              "default": false,
              "required": true
            },
            "tt": {
              "title": "Use TT",
              "type": "string",
              "default": "-tt",
              "condition": {
                "functionBody": "return model.actions[arrayIndices].isSsh === true;"
              },
              "oneOf": [
                {
                  "title": "-tt",
                  "enum": [
                    "-tt"
                  ]
                },
                {
                  "title": "-t",
                  "enum": [
                    "-t"
                  ]
                }
              ],
              "required": false
            }
          }
        },
        "required": false
      }
    }
  },
  "layout": [
    {
      "type": "section",
      "title": "Global SSH Settings",
      "expandable": true,
      "expanded": true,
      "items": [
        {
          "key": "ssh.username",
          "placeholder": "username",
          "notitle": true
        },
        {
          "key": "ssh.rsa",
          "placeholder": "RSA Token Path",
          "notitle": true
        },
        {
          "key": "ssh.port",
          "placeholder": "IP:Port",
          "notitle": true
        }
      ]
    },
    {
      "type": "section",
      "title": "Actions",
      "expandable": true,
      "expanded": true,
      "items": [
        {
          "key": "actions",
          "type": "array",
          "items": [
            {
              "type": "div",
              "items": [
                {
                  "type": "div",
                  "displayFlex": true,
                  "flex-direction": "row",
                  "items": [
                    {
                      "key": "actions[].id",
                      "placeholder": "UniqueID",
                      "notitle": true,
                      "flex": "3 3 40px",
                      "unique": true
                    },
                    {
                      "key": "actions[].name",
                      "placeholder": "Display Name",
                      "notitle": true,
                      "flex": "3 3 150px"
                    }
                  ]
                },
                {
                  "type": "div",
                  "displayFlex": true,
                  "flex-direction": "row",
                  "items": [
                    {
                      "key": "actions[].sudo"
                    },
                    {
                      "key": "actions[].isSsh"
                    },
                    {
                      "key": "actions[].tt"
                    }
                  ]
                },
                {
                  "type": "array",
                  "items": [
                    {
                      "type": "div",
                      "displayFlex": true,
                      "flex-direction": "row",
                      "items": [
                        {
                          "key": "actions[].commands[].name",
                          "placeholder": "display name",
                          "notitle": true
                        },
                        {
                          "key": "actions[].commands[].command",
                          "placeholder": "command.sh -args",
                          "notitle": true
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}